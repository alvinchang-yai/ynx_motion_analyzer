<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ynx_motion_analyzer</name>
  <version>0.0.1</version>
  <description>Record commanded vs. feedback joint motion from any hardware described by a YAML
    hardware profile (MotoROS2 and generic ros2_control built in), analyze the delay in a local web
    dashboard, and drive repeatable latency test moves via MoveIt.</description>
  <maintainer email="alvin71134@gmail.com">changal</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>ament_index_python</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>

  <!-- Message types of the built-in profiles' topics, needed to record and read them back. -->
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>industrial_msgs</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
